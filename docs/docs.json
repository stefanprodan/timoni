{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Timoni",
  "description": "Timoni is a package manager for Kubernetes powered by CUE lang.",
  "colors": {
    "primary": "#7e56c2",
    "light": "#a98be0",
    "dark": "#6500b0"
  },
  "logo": {
