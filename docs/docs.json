    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "The page you are looking for does not exist or has moved.\n\n<CardGroup cols={2}>\n  <Card title=\"Quickstart\" icon=\"rocket\" href=\"/quickstart\">Deploy your first module in minutes.</Card>\n  <Card title=\"Installation\" icon=\"download\" href=\"/install\">Get the Timoni CLI for your OS.</Card>\n  <Card title=\"CUE Reference\" icon=\"code\" href=\"/cue/module/initialization\">Author Timoni modules with CUE.</Card>\n  <Card title=\"CLI Reference\" icon=\"terminal\" href=\"/cmd/timoni\">Every timoni command and flag.</Card>\n</CardGroup>\n\nFollowed a broken link? [Open an issue](https://github.com/stefanprodan/timoni/issues) so we can fix it."
    }
